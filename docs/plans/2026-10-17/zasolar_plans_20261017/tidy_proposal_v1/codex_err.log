  print(a,'-',b,'  '.join(f'{n} {x:+.3f} [{l:+.3f},{h:+.3f}] p={q:.3f}' for n,x,l,h,q in zip(nm,pt,lo,hi,p)))
print('== object-level McNemar on recall (same GT objects)')
