def met(t):
  R=t.nh.sum()/t.ng.sum();Pr=t.ntp.sum()/t.npred.sum(); return np.array([Pr,R,2*Pr*R/(Pr+R),(t.npred-t.ntp).sum()/t.va.sum(),t.h410.sum()/t.n410.sum()])
